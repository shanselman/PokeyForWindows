<Window
    x:Class="PokeyForWindows.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Canvas
        x:Name="OverlayCanvas"
        ClipToBounds="True"
        IsHitTestVisible="False">
        <Canvas
            x:Name="PointerRoot"
            Width="800"
            Height="800"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform
                        x:Name="DepthScale"
                        CenterX="18"
                        CenterY="2" />
                    <TranslateTransform x:Name="JabTranslation" />
                    <RotateTransform
                        x:Name="PointerRotation"
                        CenterX="18"
                        CenterY="2"
                        Angle="-30" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <Border
                x:Name="PointerStick"
                Canvas.Left="20"
                Canvas.Top="40"
                Width="14"
                Height="400"
                CornerRadius="7" />

            <Path
                x:Name="PointerHand"
                Width="48"
                Height="49"
                RenderTransformOrigin="0.4,0.3"
                Data="{StaticResource PointerHandGeometry}"
                Fill="White"
                Stretch="Uniform"
                Stroke="Black"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeThickness="1.8">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="PinchScale" ScaleX="1" ScaleY="1" />
                </Path.RenderTransform>
            </Path>
        </Canvas>

        <Path
            x:Name="PrimaryFlash"
            Width="64"
            Height="64"
            Fill="Black"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Uniform">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PrimaryFlashScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PrimaryFlashRotation" />
                </TransformGroup>
            </Path.RenderTransform>
        </Path>

        <Path
            x:Name="SecondaryFlash"
            Width="48"
            Height="48"
            Fill="Black"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Uniform">
            <Path.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SecondaryFlashScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="SecondaryFlashRotation" />
                </TransformGroup>
            </Path.RenderTransform>
        </Path>
    </Canvas>
</Window>
